# Server-only configuration for the iPhone app.
# Never copy this file with real values into public/ or source control.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional server secret for private username lookup. Email login does not need it.
SUPABASE_SERVICE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# Development email confirmation origin; production must use the public HTTPS server.
W8G_AUTH_BASE_URL=http://MacBook-Pro.local:8787
